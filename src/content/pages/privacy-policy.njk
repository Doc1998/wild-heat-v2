{% extends "layouts/base.html" %}

{% block head %}
{% endblock %}

{% block body %}
<style>
  :root {
    --pd-primary: #1C2B2B;
    --pd-accent: #5F9EA0;
    --pd-accent-warm: #C68B4E;
    --pd-light: #F7F5F1;
    --pd-white: #ffffff;
    --pd-slate: #3D4F4F;
    --pd-mist: #E8EDEC;
    --pd-font-display: 'Fraunces', serif;
    --pd-font-body: 'DM Sans', sans-serif;
  }

  .atlantic-saunas-privacy-policy *,
  .atlantic-saunas-privacy-policy *::before,
  .atlantic-saunas-privacy-policy *::after {
    box-sizing: border-box;
  }

  .atlantic-saunas-privacy-policy {
    font-family: var(--pd-font-body);
    color: var(--pd-primary);
    background: var(--pd-light);
    line-height: 1.7;
  }

  /* ── HERO ── */
  .atlantic-saunas-privacy-policy .pp-hero {
    background: linear-gradient(135deg, #1C2B2B 0%, #2E4444 55%, #3D5A5A 100%);
    padding: 80px 24px 72px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .atlantic-saunas-privacy-policy .pp-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 60% 40%, rgba(95,158,160,0.18) 0%, transparent 70%),
                radial-gradient(ellipse at 20% 80%, rgba(198,139,78,0.10) 0%, transparent 60%);
    pointer-events: none;
  }

  .atlantic-saunas-privacy-policy .pp-hero-eyebrow {
    display: inline-block;
    font-family: var(--pd-font-body);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--pd-accent);
    margin-bottom: 18px;
  }

  .atlantic-saunas-privacy-policy .pp-hero h1 {
    font-family: var(--pd-font-display);
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 700;
    color: var(--pd-white);
    margin: 0 0 16px;
    line-height: 1.15;
  }

  .atlantic-saunas-privacy-policy .pp-hero-sub {
    font-size: 1rem;
    color: rgba(255,255,255,0.72);
    max-width: 520px;
    margin: 0 auto;
  }

  /* ── CONTENT WRAPPER ── */
  .atlantic-saunas-privacy-policy .pp-content {
    max-width: 780px;
    margin: 0 auto;
    padding: 64px 24px 80px;
  }

  .atlantic-saunas-privacy-policy .pp-content h2 {
    font-family: var(--pd-font-display);
    font-size: 1.45rem;
    font-weight: 600;
    color: var(--pd-primary);
    margin: 48px 0 14px;
    padding-top: 8px;
    border-top: 1px solid var(--pd-mist);
  }

  .atlantic-saunas-privacy-policy .pp-content h2:first-child {
    margin-top: 0;
    border-top: none;
  }

  .atlantic-saunas-privacy-policy .pp-content p {
    margin: 0 0 18px;
    color: var(--pd-slate);
    font-size: 0.97rem;
  }

  .atlantic-saunas-privacy-policy .pp-content ul {
    margin: 0 0 18px 0;
    padding-left: 22px;
  }

  .atlantic-saunas-privacy-policy .pp-content ul li {
    color: var(--pd-slate);
    font-size: 0.97rem;
    margin-bottom: 8px;
  }

  .atlantic-saunas-privacy-policy .pp-content a {
    color: var(--pd-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .atlantic-saunas-privacy-policy .pp-content a:hover {
    color: var(--pd-accent-warm);
  }

  .atlantic-saunas-privacy-policy .pp-updated {
    display: inline-block;
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--pd-accent-warm);
    font-weight: 600;
    margin-bottom: 40px;
  }

  /* ── CTA BAND ── */
  .atlantic-saunas-privacy-policy .pp-cta-band {
    background: linear-gradient(135deg, #1C2B2B 0%, #2E4444 100%);
    padding: 64px 24px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .atlantic-saunas-privacy-policy .pp-cta-band::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 100%, rgba(95,158,160,0.15) 0%, transparent 65%);
    pointer-events: none;
  }

  .atlantic-saunas-privacy-policy .pp-cta-band h2 {
    font-family: var(--pd-font-display);
    font-size: clamp(1.6rem, 3.5vw, 2.3rem);
    font-weight: 700;
    color: var(--pd-white);
    margin: 0 0 14px;
  }

  .atlantic-saunas-privacy-policy .pp-cta-band p {
    color: rgba(255,255,255,0.72);
    font-size: 1rem;
    max-width: 480px;
    margin: 0 auto 32px;
  }

  .atlantic-saunas-privacy-policy .btn-primary {
    display: inline-block;
    background: var(--pd-accent-warm);
    color: var(--pd-white);
    font-family: var(--pd-font-body);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 16px 36px;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    position: relative;
    z-index: 1;
  }

  .atlantic-saunas-privacy-policy .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(198,139,78,0.35);
  }

  .atlantic-saunas-privacy-policy .btn-primary:focus-visible {
    outline: 3px solid var(--pd-accent);
    outline-offset: 4px;
  }

  /* ── RESPONSIVE ── */
  @media (min-width: 768px) {
    .atlantic-saunas-privacy-policy .pp-hero {
      padding: 100px 40px 90px;
    }

    .atlantic-saunas-privacy-policy .pp-content {
      padding: 80px 40px 96px;
    }

    .atlantic-saunas-privacy-policy .pp-cta-band {
      padding: 80px 40px;
    }
  }

  @media (min-width: 1024px) {
    .atlantic-saunas-privacy-policy .pp-content {
      padding: 96px 0 112px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .atlantic-saunas-privacy-policy .btn-primary {
      transition: none;
    }
  }
</style>

