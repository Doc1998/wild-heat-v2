  <!-- ══ QUOTE FORM ══ -->
  <section class="section form-section" id="quote-form" aria-labelledby="form-h2">
    <div class="section__container">
      <header class="section__header">
        <span class="eyebrow eyebrow--white">Get Started</span>
        <h2 id="form-h2">Get Your Free Quote</h2>
        <p>Takes less than a minute. No obligation — we'll be in touch within one working day.</p>
      </header>

      <form name="quote-landing" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="quote-form">
        <input type="hidden" name="form-name" value="quote-landing">
        <p hidden><label>Don't fill this out: <input name="bot-field"></label></p>
        <div class="form-row">
          <div class="form-group">
            <label for="ql-name">Full Name</label>
            <input type="text" id="ql-name" name="name" placeholder="Your name" required autocomplete="name">
          </div>
          <div class="form-group">
            <label for="ql-phone">Phone Number</label>
            <input type="tel" id="ql-phone" name="phone" placeholder="+353 ..." required autocomplete="tel">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="ql-type">Interested In</label>
            <select id="ql-type" name="sauna_type" required>
              <option value="" disabled selected>Select an option</option>
              <option value="Pre-built barrel sauna">Pre-built barrel sauna</option>
              <option value="Custom build">Custom build</option>
              <option value="Not sure yet">Not sure yet</option>
            </select>
          </div>
          <div class="form-group">
            <label for="ql-eircode">Eircode</label>
            <input type="text" id="ql-eircode" name="eircode" placeholder="e.g. D02 XY45" required autocomplete="postal-code">
          </div>
        </div>
        <div class="form-group" style="margin-bottom: 1.2rem;">
          <label for="ql-email">Email Address</label>
          <input type="email" id="ql-email" name="email" placeholder="you@example.com" required autocomplete="email">
        </div>
        <button type="submit" class="btn btn-form">Get My Free Quote</button>
      </form>
      <p class="form-microcopy">🔒 Your details are safe with us. No spam, ever.</p>
    </div>
  </section>

