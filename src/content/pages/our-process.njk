---
title: 'Our Sauna Build Process | Wild Heat Saunas Ireland'
description: 'Discover our end-to-end sauna design and build process. Wild Heat Saunas delivers luxury custom home saunas, plus pre-built barrel saunas, across Ireland. Fast free quotes — call today.'
preloadImg: '/assets/images/sauna-hero.png'
permalink: '/our-process/'
eleventyNavigation:
  key: Our Process
  order: 200
---

{% extends "layouts/base.html" %}

{% block head %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=DM+Sans:wght@400;500;600;700&display=swap">
{% endblock %}

{% block body %}
<style>
  :root {
    --pd-cedar: #A0522D;
    --pd-cedar-light: #C68B5A;
    --pd-cedar-warm: #F5EDE0;
    --pd-teal: #D97620;
    --pd-teal-light: #E89A52;
    --pd-teal-muted: #F5EDE0;
    --pd-slate: #14110D;
    --pd-slate-mid: #6B6156;
    --pd-off-white: #FAF8F5;
    --pd-white: #ffffff;
    --pd-hairline: rgba(20,17,13,0.12);
    --pd-shadow-warm: 0 8px 40px rgba(100,60,20,0.09);
    --pd-font-display: 'Fraunces', serif;
    --pd-font-body: 'DM Sans', sans-serif;
  }

  .wild-heat-saunas-our-process *,
  .wild-heat-saunas-our-process *::before,
  .wild-heat-saunas-our-process *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  .wild-heat-saunas-our-process {
    font-family: var(--pd-font-body);
    color: var(--pd-slate);
    background: var(--pd-off-white);
    overflow-x: hidden;
  }

  /* ── HERO ─────────────────────────────────────────────── */
  .wild-heat-saunas-our-process .op-hero {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: center;
    background: var(--pd-slate);
    overflow: hidden;
  }

  .wild-heat-saunas-our-process .op-hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.38;
  }

  /* subtle steam/haze overlay */
  .wild-heat-saunas-our-process .op-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      160deg,
      rgba(46,58,58,0.72) 0%,
      rgba(217, 118, 32, 0.18) 55%,
      rgba(160,82,45,0.22) 100%
    );
    pointer-events: none;
  }

  .wild-heat-saunas-our-process .op-hero__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: 6rem 1.5rem 5rem;
  }

  .wild-heat-saunas-our-process .op-hero__eyebrow {
    display: inline-block;
    font-family: var(--pd-font-body);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--pd-teal-light);
    margin-bottom: 1.25rem;
  }

  .wild-heat-saunas-our-process .op-hero h1 {
    font-family: var(--pd-font-display);
    font-size: clamp(2.4rem, 6vw, 4.4rem);
    font-weight: 700;
    line-height: 1.12;
    color: var(--pd-white);
    max-width: 720px;
    margin-bottom: 1.25rem;
  }

  .wild-heat-saunas-our-process .op-hero__sub {
    font-size: clamp(1rem, 2.2vw, 1.2rem);
    color: rgba(255,255,255,0.82);
    max-width: 540px;
    line-height: 1.65;
    margin-bottom: 2.4rem;
  }

  .wild-heat-saunas-our-process .op-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2.8rem;
  }

  .wild-heat-saunas-our-process .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--pd-font-display);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--pd-white);
    background: var(--pd-teal);
    border: 2px solid var(--pd-teal);
    padding: 0.85rem 1.9rem;
    border-radius: 8px;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  .wild-heat-saunas-our-process .btn-primary:hover,
  .wild-heat-saunas-our-process .btn-primary:focus-visible {
    background: var(--pd-teal-light);
    border-color: var(--pd-teal-light);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(217, 118, 32, 0.28);
    outline: none;
  }

  .wild-heat-saunas-our-process .btn-outline {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--pd-font-display);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--pd-white);
    background: transparent;
    border: 2px solid rgba(255,255,255,0.55);
    padding: 0.85rem 1.9rem;
    border-radius: 8px;
    text-decoration: none;
    transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }

  .wild-heat-saunas-our-process .btn-outline:hover,
  .wild-heat-saunas-our-process .btn-outline:focus-visible {
    border-color: var(--pd-white);
    background: rgba(255,255,255,0.08);
    transform: translateY(-2px);
    outline: none;
  }

  .wild-heat-saunas-our-process .op-hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem 2.4rem;
    list-style: none;
  }

  .wild-heat-saunas-our-process .op-hero__trust li {
    font-size: 0.82rem;
    color: rgba(255,255,255,0.72);
    letter-spacing: 0.04em;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .wild-heat-saunas-our-process .op-hero__trust li svg {
    flex-shrink: 0;
    color: var(--pd-teal-light);
  }

  /* ── INTRO / OVERVIEW ─────────────────────────────────── */
  .wild-heat-saunas-our-process .op-intro {
    background: var(--pd-white);
    padding: 6rem 1.5rem;
  }

  .wild-heat-saunas-our-process .op-intro__inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  .wild-heat-saunas-our-process .op-intro__img-wrap {
    border-radius: 14px;
    overflow: hidden;
    box-shadow: var(--pd-shadow-warm);
    position: relative;
  }

  /* warm wood-grain shimmer overlay on image */
  .wild-heat-saunas-our-process .op-intro__img-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(160,82,45,0.07) 0%, transparent 60%);
    pointer-events: none;
  }

  .wild-heat-saunas-our-process .op-intro__img-wrap img {
    width: 100%;
    height: auto;
    display: block;
  }

  .wild-heat-saunas-our-process .op-intro__text .eyebrow {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--pd-teal);
    margin-bottom: 1rem;
  }

  .wild-heat-saunas-our-process .op-intro__text h2 {
    font-family: var(--pd-font-display);
    font-size: clamp(1.9rem, 4vw, 2.9rem);
    font-weight: 700;
    line-height: 1.18;
    color: var(--pd-slate);
    margin-bottom: 1.4rem;
  }

  .wild-heat-saunas-our-process .op-intro__text p {
    font-size: 1.02rem;
    line-height: 1.78;
    color: var(--pd-slate-mid);
    margin-bottom: 1.1rem;
  }

  .wild-heat-saunas-our-process .op-intro__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.8rem;
  }

  .wild-heat-saunas-our-process .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--pd-slate);
    background: var(--pd-cedar-warm);
    border: 1px solid rgba(160,82,45,0.18);
    border-radius: 50px;
    padding: 0.42rem 0.9rem;
  }

  .wild-heat-saunas-our-process .badge .stars {
    color: #C68B5A;
  }

  /* ── BENEFITS / STEPS ─────────────────────────────────── */
  .wild-heat-saunas-our-process .op-steps {
    background: var(--pd-teal-muted);
    padding: 6rem 1.5rem;
    position: relative;
    overflow: hidden;
  }

  /* sea-haze gradient suggestion */
  .wild-heat-saunas-our-process .op-steps::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(217, 118, 32, 0.07) 0%, transparent 60%);
    pointer-events: none;
  }

  .wild-heat-saunas-our-process .op-steps__inner {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin: 0 auto;
  }

  .wild-heat-saunas-our-process .op-steps__head {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .wild-heat-saunas-our-process .op-steps__head .eyebrow {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--pd-teal);
    margin-bottom: 0.85rem;
  }

  .wild-heat-saunas-our-process .op-steps__head h2 {
    font-family: var(--pd-font-display);
    font-size: clamp(1.8rem, 3.8vw, 2.7rem);
    font-weight: 700;
    color: var(--pd-slate);
    line-height: 1.2;
  }

  .wild-heat-saunas-our-process .op-steps__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .wild-heat-saunas-our-process .step-card {
    background: var(--pd-white);
    border-radius: 14px;
    padding: 2rem 1.8rem;
    box-shadow: var(--pd-shadow-warm);
    border: 1px solid var(--pd-hairline);
    display: flex;
    gap: 1.4rem;
    align-items: flex-start;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .wild-heat-saunas-our-process .step-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 50px rgba(217, 118, 32, 0.13);
  }

  .wild-heat-saunas-our-process .step-card__icon {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background: var(--pd-cedar-warm);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--pd-cedar);
  }

  .wild-heat-saunas-our-process .step-card__body h3 {
    font-family: var(--pd-font-display);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--pd-slate);
    margin-bottom: 0.45rem;
  }

  .wild-heat-saunas-our-process .step-card__body p {
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--pd-slate-mid);
  }

  /* ── WHY CHOOSE US ────────────────────────────────────── */
  .wild-heat-saunas-our-process .op-why {
    background: var(--pd-slate);
    padding: 6rem 1.5rem;
    position: relative;
    overflow: hidden;
  }

  /* wet slate texture suggestion */
  .wild-heat-saunas-our-process .op-why::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(217, 118, 32, 0.12) 0%, transparent 50%, rgba(160,82,45,0.08) 100%);
    pointer-events: none;
  }

  .wild-heat-saunas-our-process .op-why__inner {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin: 0 auto;
  }

  .wild-heat-saunas-our-process .op-why__head {
    text-align: center;
    margin-bottom: 3rem;
  }

  .wild-heat-saunas-our-process .op-why__head .eyebrow {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--pd-teal-light);
    margin-bottom: 0.85rem;
  }

  .wild-heat-saunas-our-process .op-why__head h2 {
    font-family: var(--pd-font-display);
    font-size: clamp(1.8rem, 3.8vw, 2.6rem);
    font-weight: 700;
    color: var(--pd-white);
    line-height: 1.2;
  }

  .wild-heat-saunas-our-process .op-why__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .wild-heat-saunas-our-process .why-card {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 14px;
    padding: 2rem 1.8rem;
    text-align: center;
    transition: background 0.25s ease, border-color 0.25s ease;
  }

  .wild-heat-saunas-our-process .why-card:hover {
    background: rgba(217, 118, 32, 0.12);
    border-color: rgba(217, 118, 32, 0.4);
  }

  .wild-heat-saunas-our-process .why-card__icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(217, 118, 32, 0.18);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1rem;
    color: var(--pd-teal-light);
  }

  .wild-heat-saunas-our-process .why-card h3 {
    font-family: var(--pd-font-display);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--pd-white);
    margin-bottom: 0.5rem;
  }

  .wild-heat-saunas-our-process .why-card p {
    font-size: 0.88rem;
    line-height: 1.65;
    color: rgba(255,255,255,0.62);
  }

  /* ── FAQ ──────────────────────────────────────────────── */
  .wild-heat-saunas-our-process .op-faq {
    background: var(--pd-off-white);
    padding: 6rem 1.5rem;
  }

  .wild-heat-saunas-our-process .op-faq__inner {
    max-width: 780px;
    margin: 0 auto;
  }

  .wild-heat-saunas-our-process .op-faq__head {
    text-align: center;
    margin-bottom: 3rem;
  }

  .wild-heat-saunas-our-process .op-faq__head .eyebrow {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--pd-teal);
    margin-bottom: 0.85rem;
  }

  .wild-heat-saunas-our-process .op-faq__head h2 {
    font-family: var(--pd-font-display);
    font-size: clamp(1.8rem, 3.8vw, 2.6rem);
    font-weight: 700;
    color: var(--pd-slate);
    line-height: 1.2;
  }

  .wild-heat-saunas-our-process .faq-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .wild-heat-saunas-our-process .faq-item {
    border-bottom: 1px solid var(--pd-hairline);
  }

  .wild-heat-saunas-our-process .faq-item:first-child {
    border-top: 1px solid var(--pd-hairline);
  }

  .wild-heat-saunas-our-process .faq-item summary {
    list-style: none;
    padding: 1.4rem 0;
    font-family: var(--pd-font-display);
    font-size: 1.04rem;
    font-weight: 600;
    color: var(--pd-slate);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    transition: color 0.2s ease;
  }

  .wild-heat-saunas-our-process .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .wild-heat-saunas-our-process .faq-item summary:hover,
  .wild-heat-saunas-our-process .faq-item summary:focus-visible {
    color: var(--pd-teal);
    outline: none;
  }

  .wild-heat-saunas-our-process .faq-item summary .faq-icon {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1.5px solid var(--pd-teal);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--pd-teal);
    transition: transform 0.25s ease;
  }

  .wild-heat-saunas-our-process .faq-item[open] summary .faq-icon {
    transform: rotate(45deg);
  }

  .wild-heat-saunas-our-process .faq-item .faq-answer {
    font-size: 0.96rem;
    line-height: 1.78;
    color: var(--pd-slate-mid);
    padding: 0 0 1.4rem;
  }

  /* ── CTA BAND ─────────────────────────────────────────── */
  .wild-heat-saunas-our-process .op-cta {
    position: relative;
    padding: 7rem 1.5rem;
    background: var(--pd-cedar-warm);
    overflow: hidden;
  }

  .wild-heat-saunas-our-process .op-cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, rgba(160,82,45,0.1) 0%, rgba(217, 118, 32, 0.09) 100%);
    pointer-events: none;
  }

  /* wave-like top edge */
  .wild-heat-saunas-our-process .op-cta::after {
    content: '';
    position: absolute;
    top: -2px;
    left: 0;
    right: 0;
    height: 60px;
    background: var(--pd-off-white);
    clip-path: ellipse(56% 100% at 50% 0%);
    pointer-events: none;
  }

  .wild-heat-saunas-our-process .op-cta__inner {
    position: relative;
    z-index: 1;
    max-width: 680px;
    margin: 0 auto;
    text-align: center;
  }

  .wild-heat-saunas-our-process .op-cta__inner .eyebrow {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--pd-teal);
    margin-bottom: 0.85rem;
  }

  .wild-heat-saunas-our-process .op-cta__inner h2 {
    font-family: var(--pd-font-display);
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 700;
    color: var(--pd-slate);
    line-height: 1.15;
    margin-bottom: 0.85rem;
  }

  .wild-heat-saunas-our-process .op-cta__inner p {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--pd-slate-mid);
    margin-bottom: 2.4rem;
  }

  .wild-heat-saunas-our-process .op-cta-form {
    background: var(--pd-white);
    border-radius: 14px;
    padding: 2.2rem 2rem;
    box-shadow: var(--pd-shadow-warm);
    text-align: left;
    margin-bottom: 1.8rem;
  }

  .wild-heat-saunas-our-process .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .wild-heat-saunas-our-process .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .wild-heat-saunas-our-process .form-group label {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--pd-slate);
    text-transform: uppercase;
  }

  .wild-heat-saunas-our-process .form-group input,
  .wild-heat-saunas-our-process .form-group select,
  .wild-heat-saunas-our-process .form-group textarea {
    font-family: var(--pd-font-body);
    font-size: 0.96rem;
    color: var(--pd-slate);
    background: var(--pd-off-white);
    border: 1.5px solid var(--pd-hairline);
    border-radius: 8px;
    padding: 0.72rem 1rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    width: 100%;
  }

  .wild-heat-saunas-our-process .form-group input:focus,
  .wild-heat-saunas-our-process .form-group select:focus,
  .wild-heat-saunas-our-process .form-group textarea:focus {
    border-color: var(--pd-teal);
    box-shadow: 0 0 0 3px rgba(217, 118, 32, 0.15);
    outline: none;
  }

  .wild-heat-saunas-our-process .form-group textarea {
    resize: vertical;
    min-height: 100px;
  }

  .wild-heat-saunas-our-process .btn-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    font-family: var(--pd-font-display);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--pd-white);
    background: var(--pd-teal);
    border: none;
    border-radius: 8px;
    padding: 0.95rem 2rem;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  .wild-heat-saunas-our-process .btn-submit:hover,
  .wild-heat-saunas-our-process .btn-submit:focus-visible {
    background: var(--pd-teal-light);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(217, 118, 32, 0.28);
    outline: none;
  }

  .wild-heat-saunas-our-process .op-cta__call {
    font-size: 0.9rem;
    color: var(--pd-slate-mid);
  }

  .wild-heat-saunas-our-process .op-cta__call a {
    color: var(--pd-teal);
    font-weight: 700;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .wild-heat-saunas-our-process .op-cta__call a:hover {
    color: var(--pd-cedar);
