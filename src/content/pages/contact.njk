---
title: 'Contact Wild Heat Saunas | Free Sauna Quote Ireland'
description: 'Contact Wild Heat Saunas for a fast free quote on your custom home sauna build across Ireland. Call, WhatsApp or fill in our quick quote form today.'
preloadImg: '/assets/images/contact-hero.jpg'
permalink: '/contact/'
eleventyNavigation:
  key: Contact
  order: 500
---

{% extends "layouts/base.html" %}

{% block head %}
{% endblock %}

{% block body %}
<style>
  :root {
    --pd-cedar: #A0522D;
    --pd-cedar-light: #C8843A;
    --pd-teal: #D97620;
    --pd-teal-light: #E89A52;
    --pd-teal-muted: #F5EDE0;
    --pd-ink: #14110D;
    --pd-ink-soft: #3A342C;
    --pd-off-white: #F8F6F2;
    --pd-warm-white: #FDFBF8;
    --pd-slate: #4A4A4F;
    --pd-slate-light: #8E8E93;
    --pd-shadow-warm: 0 8px 40px rgba(100, 60, 20, 0.10);
    --pd-shadow-soft: 0 4px 24px rgba(30, 30, 30, 0.07);
    --pd-font-display: 'Fraunces', serif;
    --pd-font-body: 'DM Sans', sans-serif;
    --pd-radius-card: 14px;
    --pd-radius-btn: 8px;
  }

  .wild-heat-saunas-contact *,
  .wild-heat-saunas-contact *::before,
  .wild-heat-saunas-contact *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  .wild-heat-saunas-contact {
    font-family: var(--pd-font-body);
    color: var(--pd-ink);
    background: var(--pd-warm-white);
    -webkit-font-smoothing: antialiased;
  }

  /* ── HERO ─────────────────────────────────────── */
  .wild-heat-saunas-contact .contact-hero {
    background: var(--pd-ink);
    background-image:
      radial-gradient(ellipse at 70% 50%, rgba(217, 118, 32, 0.18) 0%, transparent 65%),
      radial-gradient(ellipse at 20% 80%, rgba(160, 82, 45, 0.15) 0%, transparent 55%);
    padding: 80px 24px 72px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .wild-heat-saunas-contact .contact-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url('/assets/images/contact-hero.jpg');
    background-size: cover;
    background-position: center;
    opacity: 0.18;
    pointer-events: none;
  }

  .wild-heat-saunas-contact .hero-eyebrow {
    display: inline-block;
    font-family: var(--pd-font-body);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--pd-teal-light);
    margin-bottom: 20px;
    position: relative;
  }

  .wild-heat-saunas-contact .contact-hero h1 {
    font-family: var(--pd-font-display);
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 700;
    color: var(--pd-warm-white);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 18px;
    position: relative;
  }

  .wild-heat-saunas-contact .hero-subline {
    font-size: 1.05rem;
    color: rgba(253, 251, 248, 0.75);
    max-width: 520px;
    margin: 0 auto;
    line-height: 1.65;
    position: relative;
  }

  .wild-heat-saunas-contact .hero-subline strong {
    color: var(--pd-teal-light);
    font-weight: 600;
  }

  /* ── CONTACT GRID ─────────────────────────────── */
  .wild-heat-saunas-contact .contact-grid-section {
    background: var(--pd-off-white);
    padding: 72px 24px 80px;
  }

  .wild-heat-saunas-contact .contact-grid-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
  }

  /* FORM COLUMN */
  .wild-heat-saunas-contact .form-col {
    background: var(--pd-warm-white);
    border-radius: var(--pd-radius-card);
    padding: 40px 32px;
    box-shadow: var(--pd-shadow-warm);
    border: 1px solid rgba(160, 82, 45, 0.08);
  }

  .wild-heat-saunas-contact .col-eyebrow {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--pd-teal);
    margin-bottom: 10px;
    display: block;
  }

  .wild-heat-saunas-contact .form-col h2 {
    font-family: var(--pd-font-display);
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 700;
    color: var(--pd-ink);
    letter-spacing: -0.02em;
    margin-bottom: 8px;
    line-height: 1.2;
  }

  .wild-heat-saunas-contact .form-intro {
    font-size: 0.95rem;
    color: var(--pd-slate);
    margin-bottom: 28px;
    line-height: 1.6;
  }

  .wild-heat-saunas-contact .quote-form .form-group {
    margin-bottom: 20px;
  }

  .wild-heat-saunas-contact .quote-form label {
    display: block;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--pd-ink-soft);
    margin-bottom: 6px;
    letter-spacing: 0.02em;
  }

  .wild-heat-saunas-contact .quote-form input,
  .wild-heat-saunas-contact .quote-form textarea {
    width: 100%;
    font-family: var(--pd-font-body);
    font-size: 1rem;
    color: var(--pd-ink);
    background: var(--pd-off-white);
    border: 1.5px solid rgba(217, 118, 32, 0.25);
    border-radius: 8px;
    padding: 14px 16px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    -webkit-appearance: none;
    appearance: none;
  }

  .wild-heat-saunas-contact .quote-form input:focus,
  .wild-heat-saunas-contact .quote-form textarea:focus {
    outline: none;
    border-color: var(--pd-teal);
    box-shadow: 0 0 0 3px rgba(217, 118, 32, 0.15);
  }

  .wild-heat-saunas-contact .quote-form textarea {
    resize: vertical;
    min-height: 130px;
  }

  .wild-heat-saunas-contact .btn-submit {
    display: inline-block;
    width: 100%;
    font-family: var(--pd-font-display);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--pd-warm-white);
    background: var(--pd-cedar);
    border: none;
    border-radius: var(--pd-radius-btn);
    padding: 16px 24px;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
    box-shadow: 0 4px 18px rgba(160, 82, 45, 0.28);
    margin-top: 4px;
  }

  .wild-heat-saunas-contact .btn-submit:hover {
    background: var(--pd-cedar-light);
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(160, 82, 45, 0.34);
  }

  .wild-heat-saunas-contact .btn-submit:focus-visible {
    outline: 3px solid var(--pd-teal);
    outline-offset: 3px;
  }

  /* DETAILS COLUMN */
  .wild-heat-saunas-contact .details-col {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .wild-heat-saunas-contact .details-card {
    background: var(--pd-ink);
    background-image:
      radial-gradient(ellipse at 90% 10%, rgba(217, 118, 32, 0.20) 0%, transparent 55%),
      radial-gradient(ellipse at 10% 90%, rgba(160, 82, 45, 0.15) 0%, transparent 50%);
    border-radius: var(--pd-radius-card);
    padding: 36px 30px;
    color: var(--pd-warm-white);
  }

  .wild-heat-saunas-contact .details-card .col-eyebrow {
    color: var(--pd-teal-light);
  }

  .wild-heat-saunas-contact .details-card h2 {
    font-family: var(--pd-font-display);
    font-size: clamp(1.3rem, 2.5vw, 1.7rem);
    font-weight: 700;
    color: var(--pd-warm-white);
    letter-spacing: -0.02em;
    margin-bottom: 24px;
    line-height: 1.2;
  }

  .wild-heat-saunas-contact .contact-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-bottom: 22px;
  }

  .wild-heat-saunas-contact .contact-item:last-child {
    margin-bottom: 0;
  }

  .wild-heat-saunas-contact .contact-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: rgba(217, 118, 32, 0.18);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
  }

  .wild-heat-saunas-contact .contact-item-body {
    flex: 1;
  }

  .wild-heat-saunas-contact .contact-item-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: rgba(253, 251, 248, 0.5);
    margin-bottom: 3px;
    display: block;
  }

  .wild-heat-saunas-contact .contact-item-value {
    font-size: 0.97rem;
    color: var(--pd-warm-white);
    line-height: 1.5;
  }

  .wild-heat-saunas-contact .contact-item-value a {
    color: var(--pd-teal-light);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .wild-heat-saunas-contact .contact-item-value a:hover {
    color: var(--pd-warm-white);
  }

  .wild-heat-saunas-contact .contact-item-value a:focus-visible {
    outline: 2px solid var(--pd-teal-light);
    outline-offset: 2px;
    border-radius: 3px;
  }

  .wild-heat-saunas-contact .divider-rule {
    border: none;
    border-top: 1px solid rgba(253, 251, 248, 0.10);
    margin: 20px 0;
  }

  .wild-heat-saunas-contact .hours-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px 16px;
    font-size: 0.88rem;
  }

  .wild-heat-saunas-contact .hours-day {
    color: rgba(253, 251, 248, 0.55);
    font-weight: 500;
  }

  .wild-heat-saunas-contact .hours-time {
    color: var(--pd-warm-white);
    font-weight: 600;
  }

  /* RATING STRIP */
  .wild-heat-saunas-contact .rating-strip {
    background: var(--pd-teal-muted);
    border-radius: var(--pd-radius-card);
    padding: 22px 24px;
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .wild-heat-saunas-contact .rating-stars {
    color: #FBBF24;
    font-size: 1.1rem;
    letter-spacing: 2px;
    flex-shrink: 0;
  }

  .wild-heat-saunas-contact .rating-text {
    font-size: 0.88rem;
    color: var(--pd-ink-soft);
    line-height: 1.45;
  }

  .wild-heat-saunas-contact .rating-text strong {
    color: var(--pd-ink);
    font-weight: 700;
  }

  /* ── MAP SECTION ──────────────────────────────── */
  .wild-heat-saunas-contact .map-section {
    background: var(--pd-warm-white);
    padding: 0 24px 80px;
  }

  .wild-heat-saunas-contact .map-inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .wild-heat-saunas-contact .map-embed-wrap {
    border-radius: var(--pd-radius-card);
    overflow: hidden;
    box-shadow: var(--pd-shadow-soft);
    background: var(--pd-off-white);
    aspect-ratio: 16/7;
    min-height: 280px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(217, 118, 32, 0.15);
  }

  .wild-heat-saunas-contact .map-embed-wrap iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  .wild-heat-saunas-contact .map-placeholder-text {
    color: var(--pd-slate-light);
    font-size: 0.9rem;
    text-align: center;
    padding: 24px;
  }

  /* ── SERVICE AREA STRIP ───────────────────────── */
  .wild-heat-saunas-contact .area-strip {
    background: var(--pd-off-white);
    padding: 56px 24px 60px;
    border-top: 1px solid rgba(217, 118, 32, 0.12);
  }

  .wild-heat-saunas-contact .area-strip-inner {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .wild-heat-saunas-contact .area-strip-inner .col-eyebrow {
    color: var(--pd-teal);
    display: block;
    margin-bottom: 10px;
  }

  .wild-heat-saunas-contact .area-strip-inner h2 {
    font-family: var(--pd-font-display);
    font-size: clamp(1.3rem, 3vw, 1.75rem);
    font-weight: 700;
    color: var(--pd-ink);
    letter-spacing: -0.02em;
    margin-bottom: 20px;
  }

  .wild-heat-saunas-contact .area-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-bottom: 28px;
  }

  .wild-heat-saunas-contact .area-tag {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--pd-teal);
    background: rgba(217, 118, 32, 0.12);
    border: 1px solid rgba(217, 118, 32, 0.22);
    border-radius: 100px;
    padding: 6px 16px;
    white-space: nowrap;
  }

  .wild-heat-saunas-contact .area-cta-note {
    font-size: 0.92rem;
    color: var(--pd-slate);
    line-height: 1.6;
  }

  .wild-heat-saunas-contact .area-cta-note a {
    color: var(--pd-cedar);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .wild-heat-saunas-contact .area-cta-note a:hover {
    color: var(--pd-cedar-light);
  }

  /* ── RESPONSIVE ───────────────────────────────── */
  @media (min-width: 768px) {
    .wild-heat-saunas-contact .contact-grid-inner {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  @media (min-width: 1024px) {
    .wild-heat-saunas-contact .contact-grid-inner {
      grid-template-columns: 3fr 2fr;
      gap: 56px;
    }

    .wild-heat-saunas-contact .contact-hero {
      padding: 100px 24px 90px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wild-heat-saunas-contact .btn-submit,
    .wild-heat-saunas-contact .contact-item-value a {
      transition: none;
    }
  }
</style>

