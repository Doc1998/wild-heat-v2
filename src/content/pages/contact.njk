<div class="wild-heat-saunas-contact">

  <!-- HERO -->
  <section class="contact-hero" aria-labelledby="contact-h1">
    <span class="hero-eyebrow">Get in Touch</span>
    <h1 id="contact-h1">Get Your Fast Free Quote</h1>
    <p class="hero-subline">We typically respond <strong>within a few hours</strong>. Fill in the form below, call us, or drop us a WhatsApp — whatever suits you best.</p>
  </section>

  <!-- CONTACT GRID -->
  <section class="contact-grid-section" aria-labelledby="form-heading">
    <div class="contact-grid-inner">

      <!-- FORM -->
      <div class="form-col">
        <span class="col-eyebrow">Free Quote Request</span>
        <h2 id="form-heading">Tell Us About Your Sauna</h2>
        <p class="form-intro">A few quick details and we'll come back to you with a tailored quote — no obligation, no hard sell.</p>

        <form class="quote-form" name="quote-contact" method="POST" data-netlify="true" netlify-honeypot="bot-field">
          <input type="hidden" name="form-name" value="quote-contact">
          <p hidden><label>Don't fill this out: <input name="bot-field"></label></p>

          <div class="form-group">
            <label for="full-name">Your Name</label>
            <input type="text" id="full-name" name="name" placeholder="Laura Murphy" required>
          </div>

          <div class="form-group">
            <label for="email">Email Address</label>
            <input type="email" id="email" name="email" placeholder="laura@example.ie" required>
          </div>

          <div class="form-group">
            <label for="phone">Phone Number</label>
            <input type="tel" id="phone" name="phone" placeholder="+353 8X XXX XXXX" required>
          </div>

          <div class="form-group">
            <label for="eircode">Eircode / Postcode</label>
            <input type="text" id="eircode" name="eircode" placeholder="H91 XXXX" required>
          </div>

          <div class="form-group">
            <label for="message">Tell Us More</label>
            <textarea id="message" name="message" placeholder="Where you're thinking of putting the sauna, rough size, any particular style ideas…" required></textarea>
          </div>

          <button type="submit" class="btn-submit">Send My Quote Request</button>
        </form>
      </div>

      <!-- DETAILS -->
      <div class="details-col">
        <div class="details-card">
