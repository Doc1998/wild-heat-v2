            <div class="contact-item-body">
              <span class="contact-item-label">Call Us</span>
              <div class="contact-item-value">
                <a href="tel:+353876712695">+353 87 671 2695</a>
              </div>
            </div>
          </div>

          <div class="contact-item">
            <span class="contact-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg></span>
            <div class="contact-item-body">
              <span class="contact-item-label">WhatsApp</span>
              <div class="contact-item-value">
                <a href="https://wa.me/353876712695" target="_blank" rel="noopener noreferrer">Message us on WhatsApp</a>
              </div>
            </div>
          </div>

          <div class="contact-item">
            <span class="contact-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></span>
            <div class="contact-item-body">
              <span class="contact-item-label">Email</span>
